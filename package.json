{
  "name": "claude-terminal",
  "version": "0.1.0",
  "description": "A desktop wrapper for Claude Code: project sidebar, tabs, git status and a running-servers panel.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "icon": "node scripts/make-icon.js",
    "package": "electron-builder --win dir",
    "shortcut": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/create-shortcut.ps1"
  },
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.15",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.local.claudeterminal",
    "productName": "Claude Terminal",
    "directories": { "output": "dist" },
    "files": ["src/**", "assets/**", "package.json"],
    "asarUnpack": ["node_modules/@lydell/**"],
    "win": {
      "icon": "assets/icon.ico",
      "target": ["dir"]
    }
  }
}
